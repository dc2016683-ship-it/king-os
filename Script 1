local function L(key, ...)
	local dict = I18N[currentLang] or I18N.es
	local val = dict[key]
	if val == nil then
		val = I18N.es[key] or key
	end
	if select("#", ...) > 0 and type(val) == "string" then
		return string.format(val, ...)
	end
	return val
end

