refreshPlayerListUI = function()
	for _, child in ipairs(playerListBox:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	if selectedPlayer and not selectedPlayer.Parent then
		if spectatingTarget == selectedPlayer then
			stopSpectate(true)
		end
		selectedPlayer = nil
	end

	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			table.insert(list, plr)
		end
	end

	if #list == 0 then
		selectedLbl.Text = L("selectedEmpty")
		return
	end

	if not selectedPlayer then
		selectedPlayer = list[1]
	end

	selectedLbl.Text = L("selectedFmt", selectedPlayer.DisplayName, selectedPlayer.Name)

	for _, plr in ipairs(list) do
		local isSel = (plr == selectedPlayer)
		local roleTag = L("tagInnocent")
		if playerHasRoleTool(plr, "murder") then
			roleTag = L("tagMurder")
		elseif playerHasRoleTool(plr, "sheriff") then
			roleTag = L("tagSheriff")
		end

		local itemBtn = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 28),
			Text = plr.DisplayName .. " (@" .. plr.Name .. ")" .. roleTag,
			Font = isSel and Enum.Font.GothamBold or Enum.Font.GothamMedium,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			BackgroundColor3 = isSel and T.accent or T.bg3,
			TextColor3 = isSel and T.onAccent or T.text,
			LayoutOrder = nextOrder(),
		}, playerListBox)
		corner(itemBtn, 7)
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, itemBtn)

		itemBtn.MouseButton1Click:Connect(function()
