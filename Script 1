local function clearEspEntry(plr)
	local entry = espObjects[plr]
	if entry then
		if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
		if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
		espObjects[plr] = nil
	end
end
local function clearAllEsp()
	for plr in pairs(espObjects) do
		clearEspEntry(plr)
	end
end

local function updateMM2Esp()
	if not S.espMurder and not S.espSheriff and not S.espInnocent then
		clearAllEsp()
		return
	end

	local myRoot = getRoot()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == player then
			clearEspEntry(plr)
			continue
		end

		local hasMurder = playerHasRoleTool(plr, "murder")
		local hasSheriff = playerHasRoleTool(plr, "sheriff")
		local isMurder = S.espMurder and hasMurder
		local isSheriff = S.espSheriff and hasSheriff
		local isInnocent = S.espInnocent and (not hasMurder and not hasSheriff)

		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if not (isMurder or isSheriff or isInnocent) or not char or not hrp or not hum or hum.Health <= 0 then
			clearEspEntry(plr)
			continue
		end

		local col = Color3.fromRGB(50, 220, 110)
		local tagText = "INNOCENT"
		if isMurder and isSheriff then
			col = Color3.fromRGB(240, 45, 65)
			tagText = "MURDER / SHERIFF"
		elseif isMurder then
			col = Color3.fromRGB(240, 45, 65)
			tagText = "MURDER"
		elseif isSheriff then
			col = Color3.fromRGB(45, 130, 255)
			tagText = "SHERIFF"
		end

		local entry = espObjects[plr]
		if not entry or entry.char ~= char then
			clearEspEntry(plr)
			local hl = new("Highlight", {
				Name = "KingOS_ESP",
				Adornee = char,
				FillColor = col,
				OutlineColor = Color3.fromRGB(255, 255, 255),
				FillTransparency = 0.45,
				OutlineTransparency = 0.1,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, gui)

			local bb = new("BillboardGui", {
				Name = "KingOS_Tag",
				Adornee = hrp,
				Size = UDim2.new(0, 150, 0, 34),
				StudsOffset = Vector3.new(0, 3.2, 0),
				AlwaysOnTop = true,
			}, gui)

			local lbl = new("TextLabel", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = col,
				TextStrokeTransparency = 0.2,
				TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
				Text = tagText,
			}, bb)

			entry = { char = char, highlight = hl, billboard = bb, label = lbl }
			espObjects[plr] = entry
		end

		entry.highlight.FillColor = col
		entry.label.TextColor3 = col
		local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0
		entry.label.Text = string.format("[%s] %s (%dm)", tagText, plr.DisplayName, dist)
	end
end

track(Players.PlayerRemoving:Connect(clearEspEntry))
track(RunService.RenderStepped:Connect(updateMM2Esp))

-- ====================== NORMAL FLING ======================
local flingBusy = false

local function flingTargetPlayer(targetPlr)
	if flingBusy then
		notify(L("flingBusy"))
		return
	end
	if not targetPlr or not targetPlr.Parent or targetPlr == player then
		notify(L("flingInvalidTarget"))
		return
	end

	local targetChar = targetPlr.Character
	local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	local myChar = player.Character
	local myRoot, myHum = getRoot(), getHum()

	if not targetHrp or not targetHum or targetHum.Health <= 0 then
		notify(L("flingNoTargetChar"))
		return
	end
	if not myChar or not myRoot or not myHum then
		notify(L("flingNoMyChar"))
		return
	end

	flingBusy = true
	local prevSit = myHum.Sit
	myHum.Sit = false

	local prevCollide = {}
	for _, v in ipairs(myChar:GetDescendants()) do
		if v:IsA("BasePart") then
			prevCollide[v] = v.CanCollide
			v.CanCollide = true
		end
	end

	local bv = new("BodyVelocity", {
		MaxForce = Vector3.new(1e9, 1e9, 1e9),
		Velocity = Vector3.zero,
	}, myRoot)
	local bav = new("BodyAngularVelocity", {
		MaxTorque = Vector3.new(1e9, 1e9, 1e9),
		AngularVelocity = Vector3.new(0, 9e5, 0),
		P = 1e9,
	}, myRoot)

	notify(L("flingStart", targetPlr.DisplayName))

	local elapsed = 0
	while elapsed < 1.35 do
		local dt = RunService.Heartbeat:Wait()
		elapsed += dt

		if not targetHrp or not targetHrp.Parent or not myRoot or not myRoot.Parent then
			break
		end
		local tHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
		if tHum and tHum.Health <= 0 then
			break
		end

		local leadPos = targetHrp.Position + (targetHrp.AssemblyLinearVelocity * 0.08)
		myRoot.CFrame = CFrame.new(leadPos)

		local pushDir = (targetHrp.Position - myRoot.Position)
		if pushDir.Magnitude < 0.1 then
			pushDir = targetHrp.CFrame.LookVector + Vector3.new(0, 0.5, 0)
		end
		pushDir = pushDir.Unit

		local launchVel = (pushDir * 165) + Vector3.new(0, 120, 0)
		bv.Velocity = launchVel
		bav.AngularVelocity = Vector3.new(0, 9e5, 0)
		myRoot.AssemblyLinearVelocity = launchVel
		myRoot.AssemblyAngularVelocity = Vector3.new(0, 9e5, 0)
	end

	pcall(function() bv:Destroy() end)
	pcall(function() bav:Destroy() end)

	if myRoot and myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end

	for part, oldState in pairs(prevCollide) do
		if part and part.Parent then
			part.CanCollide = oldState
		end
	end
	if myHum and myHum.Parent then
		myHum.Sit = prevSit
	end

	flingBusy = false
	notify(L("flingDone"))
end

local function flingRole(role)
	local targetPlr = findMM2Target(role)
	if not targetPlr then
		notify(role == "murder" and L("noMurder") or L("noSheriff"))
		return
	end
	flingTargetPlayer(targetPlr)
end

local function findDroppedGun()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "GunDrop" or (obj:IsA("BasePart") and string.lower(obj.Name) == "gundrop") then
			return obj
		elseif obj:IsA("Tool") and (string.lower(obj.Name) == "gun" or string.find(string.lower(obj.Name), "gun")) then
			local handle = obj:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				return handle
			end
		end
	end
	return nil
end

local tpGunBusy = false
local function teleportToGunAndBack()
	if tpGunBusy then return end
	local gunPart = findDroppedGun()
	local myRoot = getRoot()
	if not gunPart then
		notify(L("noGun"))
		return
	end
	if not myRoot then
		notify(L("flingNoMyChar"))
		return
	end

	tpGunBusy = true
	local oldCF = myRoot.CFrame
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.CFrame = gunPart.CFrame + Vector3.new(0, 1.5, 0)
	notify(L("pickingGun"))

	task.wait(0.35)
	if myRoot and myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.CFrame = oldCF
	end
	tpGunBusy = false
	notify(L("backToPos"))
end

