local flingBusy = false
local function isSafePos(pos)
	return pos.Y > (Workspace.FallenPartsDestroyHeight + 25) and pos.Magnitude < 4500
end

local function flingTargetPlayer(targetPlr)
	if flingBusy then
		notify("Ya hay un fling en proceso")
		return
	end
	if not targetPlr or not targetPlr.Parent or targetPlr == player then
		notify("Selecciona un jugador válido")
		return
	end

	local targetChar = targetPlr.Character
	local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	local myRoot, myHum = getRoot(), getHum()

	if not targetHrp or not targetHum or targetHum.Health <= 0 then
		notify("Objetivo sin personaje activo")
		return
	end
	if not myRoot or not myHum then
		notify("Tu personaje no está listo")
		return
	end

	flingBusy = true
	local returnCF = isSafePos(myRoot.Position) and myRoot.CFrame or (targetHrp.CFrame * CFrame.new(0, 4, 6))
	local prevSit = myHum.Sit
	myHum.Sit = false

	local prevCollide = {}
	for _, v in ipairs(player.Character:GetDescendants()) do
		if v:IsA("BasePart") then
			prevCollide[v] = v.CanCollide
			v.CanCollide = true
		end
	end

	local spinRate = 1e6
	local bv = new("BodyVelocity", {
		MaxForce = Vector3.new(1e9, 1e9, 1e9),
		Velocity = Vector3.zero,
	}, myRoot)
	local bav = new("BodyAngularVelocity", {
		MaxTorque = Vector3.new(1e9, 1e9, 1e9),
		AngularVelocity = Vector3.new(0, spinRate, 0),
		P = 1e9,
	}, myRoot)

	notify("Fling v2.21 a " .. targetPlr.DisplayName .. "...")
	local elapsed = 0
	local step = 0
	while elapsed < 1.85 do
		local dt = RunService.Heartbeat:Wait()
		elapsed += dt

		if not targetHrp or not targetHrp.Parent or not myRoot or not myRoot.Parent then
			break
		end
		local tHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
		if tHum and tHum.Health <= 0 then
			break
		end
		if not isSafePos(targetHrp.Position) then
			break
		end

		step += 1
		local angle = step * 1.4
		local offset = Vector3.new(
			math.cos(angle) * 0.7,
			(step % 2 == 0 and 0.35 or -0.3),
			math.sin(angle) * 0.7
		)
		local aimPos = targetHrp.Position + offset
		if not isSafePos(aimPos) then
			aimPos = Vector3.new(aimPos.X, math.max(aimPos.Y, Workspace.FallenPartsDestroyHeight + 45), aimPos.Z)
		end

		myRoot.CFrame = CFrame.new(aimPos, targetHrp.Position) * CFrame.Angles(angle * 4, angle * 6, angle * 3)

		local dir = targetHrp.Position - myRoot.Position
		if dir.Magnitude < 0.05 then
			dir = Vector3.new(math.cos(angle), 0.7, math.sin(angle))
		end
		dir = dir.Unit

		local launchVel = (dir * 235) + Vector3.new(0, 190, 0)
		bv.Velocity = launchVel
		bav.AngularVelocity = Vector3.new(spinRate, spinRate, spinRate)
		myRoot.AssemblyLinearVelocity = launchVel
		myRoot.AssemblyAngularVelocity = Vector3.new(spinRate, spinRate, spinRate)
	end

	if bv then bv:Destroy() end
	if bav then bav:Destroy() end

	if myRoot and myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
		local safeReturn = isSafePos(returnCF.Position) and returnCF or (targetHrp and targetHrp.Parent and targetHrp.CFrame * CFrame.new(0, 3, 5) or returnCF)
		if not isSafePos(safeReturn.Position) then
			safeReturn = CFrame.new(0, 12, 0)
		end
		myRoot.CFrame = safeReturn
	end

	for part, oldState in pairs(prevCollide) do
		if part and part.Parent then
			part.CanCollide = oldState
		end
	end
	if myHum and myHum.Parent then
		myHum.Sit = prevSit
	end

	flingBusy = false
	notify("Fling completado sin salir del mapa")
end

local function flingRole(role)
	local targetPlr = findMM2Target(role)
	if not targetPlr then
		notify(role == "murder" and "No se encontró Murder" or "No se encontró Sheriff")
		return
	end
	flingTargetPlayer(targetPlr)
end

local function findDroppedGun()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "GunDrop" or (obj:IsA("BasePart") and string.lower(obj.Name) == "gundrop") then
			return obj
		elseif obj:IsA("Tool") and (string.lower(obj.Name) == "gun" or string.find(string.lower(obj.Name), "gun")) then
			local handle = obj:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				return handle
			end
		end
	end
	return nil
end

local tpGunBusy = false
local function teleportToGunAndBack()
	if tpGunBusy then return end
	local gunPart = findDroppedGun()
	local myRoot = getRoot()
	if not gunPart then
		notify("No hay Gun caída en el mapa")
		return
	end
	if not myRoot then
		notify("Tu personaje no está listo")
		return
	end

	tpGunBusy = true
	local oldCF = myRoot.CFrame
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.CFrame = gunPart.CFrame + Vector3.new(0, 1.5, 0)
	notify("Recogiendo Gun...")

	task.wait(0.35)
	if myRoot and myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.CFrame = oldCF
	end
	tpGunBusy = false
	notify("Regresaste a tu posición")
end

