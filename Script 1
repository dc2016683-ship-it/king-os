			Position = UDim2.new(0, 12, 0, 29),
			BackgroundTransparency = 1,
			Text = L(descKey),
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, f)
	end
	local pill = new("TextButton", {
		Size = UDim2.new(0, 44, 0, 22),
		Position = UDim2.new(1, -56, 0.5, -11),
		Text = "",
		AutoButtonColor = false,
	}, f)
	corner(pill, 11)
	local knob = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, pill)
	corner(knob, 8)

	local state = default
	local function render(animate)
		pill.BackgroundColor3 = state and T.accent or T.bg3
		local pos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
		if animate then
			TweenService:Create(knob, TweenInfo.new(0.15), { Position = pos }):Play()
		else
			knob.Position = pos
		end
	end
	bind(function()
		lbl.TextColor3 = T.text
		lbl.Text = L(textKey)
		if sub then
			sub.TextColor3 = T.gray
			sub.Text = L(descKey)
		end
		render(false)
	end)

	local api = { default = default }
	function api.set(v)
		state = v
		render(true)
		callback(v)
	end
	function api.sync(v)
		state = v
		render(true)
	end
	pill.MouseButton1Click:Connect(function()
		api.set(not state)
	end)
	table.insert(allToggles, api)
	return api
end

local function addSlider(page, textKey, min, max, default, callback)
	local f = row(page, 58)
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 24),
		Position = UDim2.new(0, 12, 0, 4),
		BackgroundTransparency = 1,
		Text = L(textKey),
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	local valLbl = new("TextLabel", {
		Size = UDim2.new(0, 60, 0, 24),
		Position = UDim2.new(1, -72, 0, 4),
		BackgroundTransparency = 1,
		Text = tostring(default),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, f)
	local hit = new("TextButton", {
		Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.new(0, 12, 0, 28),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, f)
	local bar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BorderSizePixel = 0,
	}, hit)
	corner(bar, 3)
	local rel0 = (default - min) / (max - min)
	local fill = new("Frame", { Size = UDim2.new(rel0, 0, 1, 0), BorderSizePixel = 0 }, bar)
	corner(fill, 3)
	local knob = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(rel0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, bar)
	corner(knob, 8)
	local knobStroke = stroke(knob, 2)

	bind(function()
		lbl.TextColor3 = T.text
		lbl.Text = L(textKey)
		valLbl.TextColor3 = T.accent
		bar.BackgroundColor3 = T.bg3
		fill.BackgroundColor3 = T.accent
		knobStroke.Color = T.accent
	end)

	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local val = math.floor(min + (max - min) * rel + 0.5)
		local snapped = (val - min) / (max - min)
		fill.Size = UDim2.new(snapped, 0, 1, 0)
		knob.Position = UDim2.new(snapped, 0, 0.5, 0)
		valLbl.Text = tostring(val)
		callback(val)
	end
	hit.InputBegan:Connect(function(input)
		if isPointer(input) then
			dragging = true
			page.ScrollingEnabled = false
			setFromX(input.Position.X)
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if dragging and isPointer(input) then
			dragging = false
			page.ScrollingEnabled = true
		end
	end))
end

local function addButton(page, textKey, callback, danger)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		Text = L(textKey),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		AutoButtonColor = false,
		LayoutOrder = nextOrder(),
	}, page)
	corner(b, 10)
	local function base() return danger and DANGER or T.bg3 end
	local function baseText() return danger and Color3.fromRGB(255, 255, 255) or T.text end
	bind(function()
		b.BackgroundColor3 = base()
		b.TextColor3 = baseText()
		b.Text = L(textKey)
	end)
	b.MouseEnter:Connect(function()
		local hoverBg = danger and DANGER:Lerp(Color3.new(1, 1, 1), 0.15) or T.accent
		local hoverTx = danger and Color3.fromRGB(255, 255, 255) or T.onAccent
		TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = hoverBg, TextColor3 = hoverTx }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = base(), TextColor3 = baseText() }):Play()
	end)
	b.MouseButton1Click:Connect(callback)
	return b
end

