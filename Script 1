do
	local btnDragging, btnMoved = false, false
	local btnDragStart, btnStartPos = nil, nil
	floatBtn.InputBegan:Connect(function(input)
		if isPointer(input) then
			btnDragging = true
			btnMoved = false
			btnDragStart = input.Position
			btnStartPos = floatBtn.Position
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if btnDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - btnDragStart
			if delta.Magnitude > 8 then
				btnMoved = true
			end
			floatBtn.Position = UDim2.new(
				btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X,
				btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y
			)
		end
	end))
	floatBtn.InputEnded:Connect(function(input)
		if btnDragging and isPointer(input) then
			btnDragging = false
			if not btnMoved then
				setOpen(not opened)
			end
		end
	end)
end

