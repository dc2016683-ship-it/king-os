	task.delay(2.6, function()
		if not f.Parent then return end
		local tw = TweenService:Create(f, TweenInfo.new(0.35), { GroupTransparency = 1 })
		tw:Play()
		tw.Completed:Wait()
		f:Destroy()
	end)
end

