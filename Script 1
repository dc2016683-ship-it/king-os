	if selectedPlayer and not selectedPlayer.Parent then
		selectedPlayer = nil
	end

	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			table.insert(list, plr)
		end
	end

	if #list == 0 then
		selectedLbl.Text = L("selectedEmpty")
		return
	end

	if not selectedPlayer then
		selectedPlayer = list[1]
	end

	selectedLbl.Text = L("selectedFmt", selectedPlayer.DisplayName, selectedPlayer.Name)

	for _, plr in ipairs(list) do
		local isSel = (plr == selectedPlayer)
		local roleTag = L("tagInnocent")
