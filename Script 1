	S.espInnocent = false
	clearAllEsp()
	S.fullbright, S.noShadows, S.noFog, S.fov = false, false, false, nil
	restoreLight({ "Brightness", "Ambient", "OutdoorAmbient", "GlobalShadows", "FogEnd", "ClockTime" })
	Workspace.Gravity = origGravity
	local hum = getHum()
	if hum then
		hum.WalkSpeed = origWalk
		hum.JumpPower = origJump
