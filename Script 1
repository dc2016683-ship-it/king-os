local noclipChanged = setmetatable({}, { __mode = "k" })
local function restoreNoclip()
	for part in pairs(noclipChanged) do
		if part and part.Parent then
			part.CanCollide = true
		end
	end
	table.clear(noclipChanged)
end

-- Air Walk invisible platform
local airPart = new("Part", {
	Name = "KingOS_AirWalk",
	Size = Vector3.new(6, 0.6, 6),
	Anchored = true,
	CanCollide = false,
	Transparency = 1,
}, Workspace)

local function updateAirWalk()
	local root = getRoot()
	if S.airWalk and root and not S.fly then
		airPart.CanCollide = true
		airPart.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.35, root.Position.Z)
	else
		airPart.CanCollide = false
	end
end

-- FLING spin high-velocity angular force
local FLING_SPIN_MULT = 1928388181818283818181
local flingSpinBav = nil
local flingSpinRoot = nil

local function stopFlingSpin()
	if flingSpinBav then
		pcall(function() flingSpinBav:Destroy() end)
		flingSpinBav = nil
	end
	if flingSpinRoot and flingSpinRoot.Parent then
		flingSpinRoot.AssemblyAngularVelocity = Vector3.zero
	end
	flingSpinRoot = nil
end

local function updateFlingSpin()
	if not S.spinBot or S.fly then
		stopFlingSpin()
		return
	end
	local root = getRoot()
	if not root or not root.Parent then
		stopFlingSpin()
		return
	end
	if flingSpinRoot ~= root or not flingSpinBav or not flingSpinBav.Parent then
		stopFlingSpin()
		flingSpinRoot = root
		flingSpinBav = new("BodyAngularVelocity", {
			Name = "KingOS_FlingSpin",
			MaxTorque = Vector3.new(math.huge, math.huge, math.huge),
			AngularVelocity = Vector3.new(0, FLING_SPIN_MULT * math.max(1, S.spinSpeed), 0),
			P = math.huge,
		}, root)
	else
		local rate = FLING_SPIN_MULT * math.max(1, S.spinSpeed)
		flingSpinBav.AngularVelocity = Vector3.new(0, rate, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, rate, 0)
	end
end

track(RunService.Stepped:Connect(function()
	if S.noclip or S.fly then
		local c = player.Character
		if c then
			for _, v in ipairs(c:GetDescendants()) do
				if v:IsA("BasePart") and v.CanCollide then
					noclipChanged[v] = true
					v.CanCollide = false
				end
			end
		end
	end
	updateAirWalk()
