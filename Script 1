local flyBV, flyBG
local flyUp, flyDown = false, false

local function stopFly()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local hum = getHum()
	if hum then
		hum.PlatformStand = false
	end
end

local function startFly()
	local root, hum = getRoot(), getHum()
	if not root or not hum then return false end
	stopFly()
	flyBV = new("BodyVelocity", {
		MaxForce = Vector3.new(1e9, 1e9, 1e9),
		Velocity = Vector3.zero,
	}, root)
	flyBG = new("BodyGyro", {
		MaxTorque = Vector3.new(1e9, 1e9, 1e9),
		P = 9e4,
		CFrame = root.CFrame,
	}, root)
	hum.PlatformStand = true
	return true
end

track(RunService.RenderStepped:Connect(function()
	local cam = Workspace.CurrentCamera

	if S.fov and cam then
		cam.FieldOfView = S.fov
	end

	if not S.fly then return end
	local root, hum = getRoot(), getHum()
	if not (root and hum and cam) then return end
	if not flyBV or not flyBV.Parent then
		if not startFly() then return end
	end

	local dir = Vector3.zero
	if hum.MoveDirection.Magnitude > 0 then
		local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
		dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
	end
	local up = Vector3.new(0, 1, 0)
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) or flyUp then
		dir += up
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or flyDown then
		dir -= up
	end
	if dir.Magnitude > 0 then
		dir = dir.Unit
	end

	flyBV.Velocity = dir * S.flySpeed
	flyBG.CFrame = cam.CFrame
end))

