-- ====================== OPEN / CLOSE ======================
local function setOpen(v)
	if v == opened then return end
	opened = v
	if v then
		main.Visible = true
		local target = minimized and MIN_SIZE or FULL_SIZE
		main.Size = UDim2.new(0, target.X.Offset * 0.94, 0, target.Y.Offset * 0.94)
		main.GroupTransparency = 1
		local info = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(main, info, { Size = target, GroupTransparency = panelAlpha }):Play()
	else
		local info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(main, info, {
			Size = UDim2.new(0, main.Size.X.Offset * 0.94, 0, main.Size.Y.Offset * 0.94),
			GroupTransparency = 1,
		}):Play()
		task.delay(0.17, function()
			if not opened then main.Visible = false end
		end)
	end
end

