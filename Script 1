track(RunService.RenderStepped:Connect(function(dt)
	local cam = Workspace.CurrentCamera

	if S.fov and cam then
		cam.FieldOfView = S.fov
	end

	-- FLING spin: rotación a velocidad 1928388181818283818181
	if S.spinBot and not S.fly then
		local root = getRoot()
		if root then
			local angle = (FLING_SPIN_MULT * math.max(1, S.spinSpeed)) % (math.pi * 2)
			root.CFrame = root.CFrame * CFrame.Angles(0, angle, 0)
			root.AssemblyAngularVelocity = Vector3.new(0, FLING_SPIN_MULT * math.max(1, S.spinSpeed), 0)
		end
	end

	-- Vuelo fluido controlado por CFrame + velocidad limpia
	if S.fly then
		local root, hum = getRoot(), getHum()
		if not (root and hum and cam) then return end
		hum.PlatformStand = true

		local dir = Vector3.zero
		if hum.MoveDirection.Magnitude > 0 then
			local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
			dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) or flyUp then
			dir += Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or flyDown then
			dir -= Vector3.new(0, 1, 0)
		end
		if dir.Magnitude > 0 then
			dir = dir.Unit
		end

		local nextPos = root.Position + dir * (S.flySpeed * math.min(dt, 0.05))
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(nextPos, nextPos + cam.CFrame.LookVector)
	end
end))

